{
  "id": "two-file-change",
  "system": "You are a coding agent. Use the tools. Reply with a one-line summary when done.",
  "prompt": "Rename the exported function `calcGoal` to `dailyGoal` in src/goal.js and update its only caller src/screen.js. Then run `npm test`.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a file in the repo",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "write_file",
        "description": "Write a file in the repo",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "run",
        "description": "Run a shell command",
        "parameters": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ]
        }
      }
    }
  ],
  "toolResults": {
    "read_file": {
      "src/goal.js": "export function calcGoal(kg) { return kg * 35; }",
      "src/screen.js": "import { calcGoal } from './goal.js';\nexport const label = (kg) => `${calcGoal(kg)} ml`;",
      "*": "ENOENT"
    },
    "write_file": "written",
    "run": "PASS (4 tests)"
  },
  "check": {
    "type": "tool-calls",
    "sequence": [
      "read_file",
      "write_file",
      "run"
    ],
    "args": [
      [
        "write_file",
        "content",
        "dailyGoal"
      ],
      [
        "run",
        "command",
        "npm test"
      ]
    ]
  }
}